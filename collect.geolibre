     },
     {
      "field": "state",
      "alias": "State",
      "widget": "valueMap",
      "required": true,
      "valueMap": [
       {
        "value": "GA"
       },
       {
        "value": "NC"
       },
       {
        "value": "TN"
       },
       {
        "value": "VA"
       },
       {
        "value": "WV"
       },
