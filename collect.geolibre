        "value": "No action"
       },
       {
        "value": "Monitor"
       },
       {
        "value": "Prune"
       },
       {
        "value": "Fell"
       },
       {
        "value": "Relocate target"
       },
       {
        "value": "Close area"
       },
       {
        "value": "Refer to arborist"
       }
      ]
     },
     {
      "field": "priority",
      "alias": "Priority",
      "widget": "valueMap",
      "valueMap": [
       {
        "value": "Immediate"
       },
       {
        "value": "Within 30 days"
       },
       {
        "value": "This season"
       },
       {
        "value": "Routine"
       }
      ]
     },
     {
      "field": "notes",
      "alias": "Notes",
      "widget": "text"
     },
     {
      "field": "gps_accuracy_m",
      "alias": "GPS accuracy (m)",
      "widget": "number",
      "defaultValue": "round(@position_horizontal_accuracy, 1)",
      "min": 0
     },
