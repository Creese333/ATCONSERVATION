      "field": "dbh_in",
      "alias": "DBH (in)",
      "widget": "number",
      "min": 0,
      "max": 120
     },
     {
      "field": "status",
      "alias": "Tree status",
      "widget": "valueMap",
      "valueMap": [
       {
        "value": "Live"
       },
       {
        "value": "Declining"
       },
       {
        "value": "Dead (snag)"
       },
       {
        "value": "Down/hung"
       }
      ]
     },
     {
      "field": "defects",
      "alias": "Defects",
      "widget": "text"
     },
     {
      "field": "target",
      "alias": "Target",
      "widget": "valueMap",
      "required": true,
      "valueMap": [
       {
        "value": "Shelter"
       },
       {
        "value": "Privy"
       },
       {
        "value": "Campsite/tent pad"
       },
       {
        "value": "Treadway"
       },
       {
        "value": "Parking area"
       },
       {
        "value": "Road"
       },
       {
        "value": "Bridge/structure"
       },
       {
        "value": "Other"
       }
      ]
     },
     {
      "field": "lof",
      "alias": "Likelihood of failure",
      "widget": "valueMap",
      "required": true,
      "valueMap": [
       {
        "value": "1",
        "label": "Improbable"
       },
       {
        "value": "2",
        "label": "Possible"
       },
       {
        "value": "3",
        "label": "Probable"
       },
       {
        "value": "4",
        "label": "Imminent"
       }
      ]
     },
     {
      "field": "loi",
      "alias": "Likelihood of impacting target",
      "widget": "valueMap",
      "required": true,
      "valueMap": [
       {
        "value": "1",
        "label": "Very low"
       },
       {
        "value": "2",
        "label": "Low"
       },
       {
        "value": "3",
        "label": "Medium"
       },
       {
        "value": "4",
        "label": "High"
       }
      ]
     },
     {
      "field": "consequence",
      "alias": "Consequences of failure",
      "widget": "valueMap",
      "required": true,
      "valueMap": [
       {
        "value": "1",
        "label": "Negligible"
       },
       {
        "value": "2",
        "label": "Minor"
       },
       {
        "value": "3",
        "label": "Significant"
       },
       {
        "value": "4",
        "label": "Severe"
       }
      ]
     },
     {
      "field": "risk_rating",
      "alias": "Risk rating",
      "widget": "valueMap",
      "valueMap": [
       {
        "value": "Low"
       },
       {
        "value": "Moderate"
       },
       {
        "value": "High"
       },
       {
        "value": "Extreme"
       }
      ],
      "defaultValue": "CASE WHEN \"lof\" IS NULL OR \"loi\" IS NULL OR \"consequence\" IS NULL THEN NULL WHEN \"lof\" = '4' AND \"loi\" = '4' AND \"consequence\" = '4' THEN 'Extreme' WHEN ((\"lof\" = '4' AND \"loi\" IN ('3', '4')) OR (\"lof\" = '3' AND \"loi\" = '4')) AND \"consequence\" IN ('3', '4') THEN 'High' WHEN ((\"lof\" = '4' AND \"loi\" IN ('3', '4')) OR (\"lof\" = '3' AND \"loi\" = '4')) AND \"consequence\" = '2' THEN 'Moderate' WHEN ((\"lof\" = '4' AND \"loi\" = '2') OR (\"lof\" = '3' AND \"loi\" = '3') OR (\"lof\" = '2' AND \"loi\" = '4')) AND \"consequence\" IN ('3', '4') THEN 'Moderate' ELSE 'Low' END"
     },
     {
      "field": "bat_roost",
      "alias": "Potential bat roost (loose bark, cavities, cracks)",
      "widget": "valueMap",
      "valueMap": [
       {
        "value": "Yes"
       },
       {
        "value": "No"
       },
       {
        "value": "Unsure"
       }
      ]
     },
